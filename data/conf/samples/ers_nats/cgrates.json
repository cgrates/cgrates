{
"db": {
    "dbConns": {
		"*default": {
            "dbType": "*internal",
            "opts":{
		    "internalDBRewriteInterval": "0s",
		    "internalDBDumpInterval": "0s"
	    }
    	},
	},
},

"ees": {
	"enabled": true,
	"exporters": [
		{
			"id": "nats_processed",
			"type": "*natsJSONMap",
			"exportPath": "nats://localhost:4222",
			"attempts": 1,
			"opts": {
				"natsJetStream": true,
				"natsSubject": "cgrates_urs_processed"
			}
		}
	]
},

"ers": {
    "enabled": true,
    "conns": {
    	"*sessions": [],
    	"*ees": [{"connIDs": ["*localhost"]}]
    },
    "readers": [
        {
            "id": "nats_reader1",
            "type": "*natsJSONMap",
            "sourcePath": "nats://127.0.0.1:4222",
            "processedPath": "nats://127.0.0.1:4222",
            "eesSuccessIDs": ["nats_processed"],
            "opts": {
                "natsJetStream": true,
                "natsConsumerName": "cgrates",
                "natsStreamName": "stream",
                "natsSubject": "cgratesURs",
                "natsQueueID": "queue",
                "natsJetStreamMaxWait": "5s"
            },
            "flags": ["*dryRun"],
            "fields":[
                {"tag": "ur_template", "type": "*template", "value": "ur_template"}
            ]
        },
        {
            "id": "nats_reader2",
            "type": "*natsJSONMap",
            "sourcePath": "nats://127.0.0.1:4222",
            "processedPath": "nats://127.0.0.1:4222",
            "eesSuccessIDs": ["nats_processed"],
            "opts": {
                "natsJetStream": true,
                "natsConsumerName": "cgrates",
                "natsStreamName": "stream",
                "natsSubject": "cgratesURs",
                "natsQueueID": "queue",
                "natsJetStreamMaxWait": "5s"
            },
            "flags": ["*dryRun"],
            "fields":[
                {"tag": "ur_template", "type": "*template", "value": "ur_template"}
            ]
        }
    ]
},

"templates": {
    "ur_template": [
        {"tag": "Account", "path": "*cgreq.Account", "type": "*variable", "value": "~*req.Account", "mandatory": true},
        {"tag": "Subject", "path": "*cgreq.Subject", "type": "*variable", "value": "~*req.Subject", "mandatory": true},
        {"tag": "Destination", "path": "*cgreq.Destination", "type": "*variable", "value": "~*req.Destination", "mandatory": true}
    ]
}

}
