{
  "admins": {
    "enabled": true
  },
  "filters": {
    "conns": {
      "*accounts": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    }
  },
  "rates": {
    "enabled": true
  },
  "accounts": {
    "enabled": true,
    "conns": {
      "*rates": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    }
  },
  "actions": {
    "enabled": true,
    "conns": {
      "*accounts": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ],
      "*cdrs": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    }
  },
  "cdrs": {
    "enabled": true,
    "opts": {
      "*accounts": [
        {
          "Value": true
        }
      ]
    },
    "conns": {
      "*accounts": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    }
  },
  "sessions": {
    "enabled": true,
    "conns": {
      "*accounts": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ],
      "*ees": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    }
  },
  "ees": {
    "enabled": true,
    "exporters": [
      {
        "id": "radius_usage",
        "type": "*fileCSV",
        "synchronous": true,
        "fields": [
          {
            "tag": "Account",
            "path": "*hdr.Account",
            "type": "*constant",
            "value": "Account"
          },
          {
            "tag": "OriginID",
            "path": "*hdr.OriginID",
            "type": "*constant",
            "value": "OriginID"
          },
          {
            "tag": "URID",
            "path": "*hdr.URID",
            "type": "*constant",
            "value": "URID"
          },
          {
            "tag": "Usage",
            "path": "*hdr.Usage",
            "type": "*constant",
            "value": "Usage"
          },
          {
            "tag": "AccountsCost",
            "path": "*hdr.AccountsCost",
            "type": "*constant",
            "value": "AccountsCost"
          },
          {
            "tag": "Account",
            "path": "*exp.Account",
            "type": "*variable",
            "value": "~*req.Account"
          },
          {
            "tag": "OriginID",
            "path": "*exp.OriginID",
            "type": "*variable",
            "value": "~*opts.*originID"
          },
          {
            "tag": "URID",
            "path": "*exp.URID",
            "type": "*variable",
            "value": "~*opts.*urID"
          },
          {
            "tag": "Usage",
            "path": "*exp.Usage",
            "type": "*variable",
            "value": "~*req.Usage"
          },
          {
            "tag": "AccountsCost",
            "path": "*exp.AccountsCost",
            "type": "*variable",
            "value": "~*opts.*accountsCost"
          }
        ]
      }
    ]
  },
  "radiusAgent": {
    "enabled": true,
    "conns": {
      "*sessions": [
        {
          "ConnIDs": [
            "*localhost"
          ]
        }
      ]
    },
    "listeners": [
      {
        "network": "udp",
        "authAddress": "127.0.0.1:1812",
        "acctAddress": "127.0.0.1:1813"
      }
    ]
  }
}
