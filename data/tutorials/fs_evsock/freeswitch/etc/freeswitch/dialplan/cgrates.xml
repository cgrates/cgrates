   <extension name="CGRateS_Auth">
      <condition field="${cgrNotify}" expression="^$">
        <action application="park" />
      </condition>
    </extension>
    <extension name="CGRateS_AuthDenied">
      <!-- hang up if cgr_notify doesn't contain AUTH_OK -->
      <condition field="${cgrNotify}" expression="^(?!.*AUTH_OK).*">  
        <action application="set" data="proto_specific_hangup_cause=sip:503" />
        <action application="hangup" />
      </condition>
    </extension>
    <extension name="DialOut">
      <condition field="${cgrRoutes}" expression=".+"> 
        <action application="set" data="cgr_route=${cgrRoutes[1]}" />
      </condition>
      <condition field="${destination_number}" expression="^(10[0-9][0-9])$">
        <action application="set" data="ringback=${us-ring}" />
        <action application="set" data="call_timeout=30" />
        <action application="bridge" data="user/${destination_number}@${domain_name}" />
      </condition>
    </extension>
