"general": {
	"nodeID":"CGRKamailio",
	"replyTimeout": "5s",
},

"logger": {
	"level": 7
},

"listen": {
	"rpcJSON": ":2012",
	"rpcGOB": ":2013",
	"http": ":2080",
},



"schedulers": {
	"enabled": true,
},


"rals": {
	"enabled": true,
	"thresholds_conns": ["*localhost"],
	"stats_conns": ["*localhost"],
},


"cdrs": {
	"enabled": true,
	"conns": {
		"*chargers": [{"connIDs": ["*internal"]}],
		"*stats": [{"connIDs": ["*localhost"]}]
	},
	"rals_conns": ["*localhost"],
	"sessions_cost_retries": 5,
},


"chargers": {
	"enabled": true,
	"conns": {
		"*attributes": [{"connIDs": ["*internal"]}]
	},
},


"sessions": {
	"enabled": true,
	"debitInterval": "5s",
	"channelSyncInterval":"5m",
	"conns":{
	"*rals": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*cdrs": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*resources": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*routes": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*attributes": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*stats": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*thresholds": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	],
	"*chargers": [
		 {
			"tenant": "",
			"filterIDs": [],
			"connIDs": ["*localhost"]
		 }
	]
			},
},


"kamailioAgent": {
	"enabled": true,
	"evapiConns":[
		{"address": "127.0.0.1:8448", "reconnects": 5}
	],
	"conns": {
		"*sessions":[{"connIDs":["*birpc_internal"]}]
	},
	"createCDR": true,
	"requestProcessors": [
		{
			"id": "SimpleAuth",
			"filters": [
				"*string:~*req.event:CGR_AUTH_REQUEST",
				"*string:~*req.replyRoute:CGR_SIMPLEAUTH_REPLY"
			],
			"flags": ["*sessions"],
			"requestFields": [
				{"tag": "BaseTmpl", "type": "*template", "value": "*kamr"},
				{"tag": "Context", "path": "*opts.*context", "type": "*variable", "value": "~*req.cgrContext"},
				{"tag": "Attributes", "path": "*opts.*attributes", "type": "*constant", "value": "true"}
			],
			"replyFields": [
				{"tag": "Event", "path": "*rep.Event", "type": "*variable", "value": "~*req.replyRoute"},
				{"tag": "TransactionIndex", "path": "*rep.TransactionIndex", "type": "*variable", "value": "~*req.trIndex"},
				{"tag": "TransactionLabel", "path": "*rep.TransactionLabel", "type": "*variable", "value": "~*req.trLabel"},
				{"tag": "Password", "path": "*rep.Attributes", "type": "*composed",
					"value": "Password:;~*cgrep.Attributes[*primary].Password;,"}
			]
		},
		{
			"id": "SessionAuth",
			"filters": [
				"*string:~*req.event:CGR_AUTH_REQUEST",
				"*string:~*req.replyRoute:CGR_SESSIONAUTH_REPLY"
			],
			"flags": ["*sessions"],
			"requestFields": [
				{"tag": "BaseTmpl", "type": "*template", "value": "*kamr"},
				{"tag": "Authorize", "path": "*opts.*authorize", "type": "*constant", "value": "true"},
				{"tag": "Attributes", "path": "*opts.*attributes", "type": "*constant", "value": "true"},
				{"tag": "Accounts", "path": "*opts.*accounts", "type": "*constant", "value": "true"},
				{"tag": "Routes", "path": "*opts.*routes", "type": "*constant", "value": "true"},
				{"tag": "Resources", "path": "*opts.*resources", "type": "*constant", "value": "true"},
				{"tag": "Thresholds", "path": "*opts.*thresholds", "type": "*constant", "value": "true"}
			],
			"replyFields": [
				{"tag": "Event", "path": "*rep.Event", "type": "*variable", "value": "~*req.replyRoute"},
				{"tag": "TransactionIndex", "path": "*rep.TransactionIndex", "type": "*variable", "value": "~*req.trIndex"},
				{"tag": "TransactionLabel", "path": "*rep.TransactionLabel", "type": "*variable", "value": "~*req.trLabel"},
				{"tag": "Password", "path": "*rep.Attributes", "type": "*composed",
					"value": "Password:;~*cgrep.Attributes[*primary].Password;,"},
				{"tag": "RequestType", "path": "*rep.Attributes", "type": "*composed",
					"value": "RequestType:;~*cgrep.Attributes[*primary].RequestType;,"},
				{"tag": "PaypalAccount", "path": "*rep.Attributes", "type": "*composed",
					"value": "PaypalAccount:;~*cgrep.Attributes[*primary].PaypalAccount;,"},
				{"tag": "LCRProfile", "path": "*rep.Attributes", "type": "*composed",
					"value": "LCRProfile:;~*cgrep.Attributes[*primary].LCRProfile;,"},
				{"tag": "ResourceAllocation", "path": "*rep.ResourceAllocation", "type": "*variable",
					"value": "~*cgrep.ResourceAllocation[*primary]"},
				{"tag": "MaxUsage", "path": "*rep.MaxUsage", "type": "*variable",
					"value": "~*vars.MaxUsage{*durationSeconds}"},
				{"tag": "RouteID", "path": "*rep.Routes", "type": "*variable",
					"value": "~*cgrep.RouteProfiles[*primary][0].Routes[0].RouteID"},
				{"tag": "RouteParameters", "path": "*rep.Routes", "type": "*composed",
					"filters": ["*notempty:~*cgrep.RouteProfiles[*primary][0].Routes[0].RouteParameters:"],
					"value": ":;~*cgrep.RouteProfiles[*primary][0].Routes[0].RouteParameters"}
			]
		},
		{
			"id": "CallStart",
			"filters": ["*string:~*req.event:CGR_CALL_START"],
			"flags": ["*sessions"],
			"requestFields": [
				{"tag": "BaseTmpl", "type": "*template", "value": "*kamr"},
				{"tag": "RequestType", "path": "*cgreq.RequestType", "type": "*variable", "value": "~*req.RequestType"},
				{"tag": "Session", "path": "*opts.*session", "type": "*constant", "value": "true"},
				{"tag": "Attributes", "path": "*opts.*attributes", "type": "*constant", "value": "true"},
				{"tag": "Accounts", "path": "*opts.*accounts", "type": "*constant", "value": "true"},
				{"tag": "Resources", "path": "*opts.*resources", "type": "*constant", "value": "true"},
				{"tag": "Thresholds", "path": "*opts.*thresholds", "type": "*constant", "value": "true"}
			]
		},
		{
			"id": "CallEnd",
			"filters": ["*string:~*req.event:CGR_CALL_END"],
			"flags": ["*sessions"],
			"requestFields": [
				{"tag": "BaseTmpl", "type": "*template", "value": "*kamr"},
				{"tag": "RequestType", "path": "*cgreq.RequestType", "type": "*variable", "value": "~*req.RequestType"},
				{"tag": "PaypalAccount", "path": "*cgreq.PaypalAccount", "type": "*variable", "value": "~*req.PaypalAccount"},
				{"tag": "Session", "path": "*opts.*session", "type": "*constant", "value": "true"},
				{"tag": "Terminate", "path": "*opts.*terminate", "type": "*constant", "value": "true"},
				{"tag": "Accounts", "path": "*opts.*accounts", "type": "*constant", "value": "true"},
				{"tag": "Resources", "path": "*opts.*resources", "type": "*constant", "value": "true"}
			]
		}
	]
},


"attributes": {
	"enabled": true,
	"stringIndexedFields": ["*req.Account"],			
},


"resources": {
	"enabled": true,
	"stringIndexedFields": ["*req.Account"],
},


"stats": {
	"enabled": true,
	"stringIndexedFields": ["*req.Account","*req.RunID","*req.Destination"],
},


"thresholds": {
	"enabled": true,
	"stringIndexedFields": ["*req.Account"],
},


"routes": {
	"enabled": true,
	"conns": {
		"*resources": [{"connIDs": ["*internal"]}],
		"*stats": [{"connIDs": ["*internal"]}]
	},
	"rals_conns": ["*internal"],	
	"stringIndexedFields": ["*req.Account"],
},


"admins": {
	"enabled": true,
},


}
